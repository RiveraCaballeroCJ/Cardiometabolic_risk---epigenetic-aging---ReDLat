# ── Helper functions ──────────────────────────────────────────────
def safe_crosstab(groups, values):
    """Manual crosstab replacement — avoids pd.crosstab C-extension issues."""
    grp_cats = sorted(set(groups))
    val_cats = sorted(set(values))
    table = np.zeros((len(grp_cats), len(val_cats)), dtype=int)
    g_idx = {g: i for i, g in enumerate(grp_cats)}
    v_idx = {v: i for i, v in enumerate(val_cats)}
    for g, v in zip(groups, values):
        if pd.notna(g) and pd.notna(v):
            table[g_idx[g], v_idx[v]] += 1
    return table, grp_cats, val_cats

def cramers_v(chi2, n, dof):
    k = dof + 1
    return np.sqrt(chi2 / (n * max(k - 1, 1)))

def welch_ttest(d1, d2):
    """Welch t-test (two independent samples, unequal variance).
    Returns: t, p, df, cohen_d
    """
    n1, n2 = len(d1), len(d2)
    m1, m2 = np.mean(d1), np.mean(d2)
    v1, v2 = np.var(d1, ddof=1), np.var(d2, ddof=1)
    se = np.sqrt(v1/n1 + v2/n2)
    if se == 0:
        return 0, 1, n1 + n2 - 2, 0
    t_stat = (m1 - m2) / se
    df_num = (v1/n1 + v2/n2)**2
    df_den = (v1/n1)**2/(n1-1) + (v2/n2)**2/(n2-1)
    df = df_num / df_den if df_den > 0 else 1
    p = 2 * (1 - t_dist.cdf(abs(t_stat), df))
    # Cohen's d (pooled SD)
    sp = np.sqrt(((n1 - 1)*v1 + (n2 - 1)*v2) / (n1 + n2 - 2))
    d = abs(m1 - m2) / sp if sp > 0 else np.nan
    return t_stat, p, df, d

