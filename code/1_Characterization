continuous_vars = {
    'demo_age':   'Age',
    'cog_ed':     'Years of Education',
    't_adlq_tot': 'Functionality (T-ADLQ)',
    'mmse_total': 'Cognitive function (MMSE)',
}

for var, label in continuous_vars.items():
    if var not in df4.columns:
        print(f"Warning: '{var}' not found -- skipped.")
        continue

    dbg = {g: pd.to_numeric(df4[df4['Group'] == g][var], errors='coerce').dropna()
           for g in GROUP_ORDER}
    vg  = [g for g in GROUP_ORDER if len(dbg[g]) >= 3]

    # Welch ANOVA via pingouin
    try:
        rows_wa = []
        for g in vg:
            for val in dbg[g]:
                rows_wa.append({'group': g, 'value': float(val)})
        df_wa = pd.DataFrame(rows_wa)

        wa = pg.welch_anova(data=df_wa, dv='value', between='group')
        F   = float(wa['F'].iloc[0])
        # pingouin column name varies by version
        p_candidates = ['p_unc', 'p-unc', 'pval', 'p']
        p_col = next((c for c in p_candidates if c in wa.columns), None)
        if p_col is None:
            raise KeyError(f"No p-value column found. Available: {list(wa.columns)}")
        p   = float(wa[p_col].iloc[0])
        # df columns also vary
        # Use pingouin's np2 (partial eta squared) if available, else compute manually
        if 'np2' in wa.columns:
            eta2 = float(wa['np2'].iloc[0])
        else:
            df1_col = 'ddof1' if 'ddof1' in wa.columns else 'df'
            df2_col = 'ddof2' if 'ddof2' in wa.columns else 'df2'
            df1 = float(wa[df1_col].iloc[0]) if df1_col in wa.columns else float(len(vg) - 1)
            df2 = float(wa[df2_col].iloc[0]) if df2_col in wa.columns else float(sum(len(dbg[g]) for g in vg) - len(vg))
            eta2 = eta_squared_welch(F, df1, df2)
        sig_str = '***' if p < 0.001 else '**' if p < 0.01 else '*' if p < 0.05 else 'ns'

        # Games-Howell post-hoc
        sig_pairs = posthoc_games_howell(dbg, vg)

        # Build row values in display order: Dem_CR, Con_CR, Dem_NonCR, Con_NonCR
        vals = []
        for g in DATA_COL_ORDER:
            d = dbg[g]
            if len(d) == 0:
                vals.append("--")
                continue
            sup = get_superscripts(g, sig_pairs, GROUP_ORDER)
            vals.append(f"{np.mean(d):.1f} ({np.std(d):.1f}){sup}")

        add_subheader(label)
        add_data_row("  Mean (SD)", vals)
        eta2_str = f"{eta2:.3f}" if not np.isnan(eta2) else "--"
        add_stat_row(f"F={F:.2f}; p={p:.3f}; η²={eta2_str} {sig_str}")

    except Exception as e:
        print(f"  Error in {label}: {e}")

