# ── Helper functions ──────────────────────────────────────────────
def cramers_v(chi2, n, dof):
    k = dof + 1  # approximate number of categories
    return np.sqrt(chi2 / (n * max(k - 1, 1)))

def eta_squared_welch(F, df_between, df_within):
    """Eta squared from Welch ANOVA F statistic."""
    ss_between = F * df_between
    ss_total   = ss_between + df_within
    return ss_between / ss_total if ss_total > 0 else np.nan

def posthoc_games_howell(data_by_group, groups):
    """Games-Howell post-hoc via pingouin; returns set of significantly different pairs."""
    rows = []
    for g in groups:
        for val in data_by_group[g]:
            rows.append({'group': g, 'value': val})
    df_ph = pd.DataFrame(rows)
    try:
        gh = pg.pairwise_gameshowell(data=df_ph, dv='value', between='group')
        sig_pairs = set()
        for _, row in gh.iterrows():
            if row['pval'] < 0.05:
                sig_pairs.add((row['A'], row['B']))
                sig_pairs.add((row['B'], row['A']))
        return sig_pairs
    except Exception as e:
        print(f"  Games-Howell error: {e}")
        return set()

def get_superscripts(group, sig_pairs, groups):
    """Return superscript letters for groups significantly different from this one."""
    sups = ''
    for other in groups:
        if other != group and (group, other) in sig_pairs:
            sups += SUPERSCRIPTS[other]
    return sups

def posthoc_chi2_fdr(df_in, group_col, var, groups):
    pairs = list(combinations(groups, 2))
    p_values, results = [], []
    for g1, g2 in pairs:
        dp = df_in[df_in[group_col].isin([g1, g2])]
        try:
            ct = pd.crosstab(dp[group_col], dp[var])
            _, p, _, _ = chi2_contingency(ct)
            p_values.append(p)
            results.append({'g1': g1, 'g2': g2, 'p_raw': p})
        except:
            p_values.append(1.0)
            results.append({'g1': g1, 'g2': g2, 'p_raw': 1.0})
    reject, p_adj, _, _ = multipletests(p_values, alpha=0.05, method='fdr_bh')
    sig_pairs = set()
    for i, r in enumerate(results):
        if reject[i]:
            sig_pairs.add((r['g1'], r['g2']))
            sig_pairs.add((r['g2'], r['g1']))
    return sig_pairs

