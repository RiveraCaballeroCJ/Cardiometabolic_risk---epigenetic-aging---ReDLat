# ── Helper functions ──────────────────────────────────────────────
def safe_crosstab(groups, values):
    """Manual crosstab replacement — avoids pd.crosstab C-extension issues."""
    grp_cats = sorted(set(groups))
    val_cats = sorted(set(values))
    table = np.zeros((len(grp_cats), len(val_cats)), dtype=int)
    g_idx = {g: i for i, g in enumerate(grp_cats)}
    v_idx = {v: i for i, v in enumerate(val_cats)}
    for g, v in zip(groups, values):
        if pd.notna(g) and pd.notna(v):
            table[g_idx[g], v_idx[v]] += 1
    return table, grp_cats, val_cats

def cramers_v(chi2, n, dof):
    k = dof + 1  # approximate number of categories
    return np.sqrt(chi2 / (n * max(k - 1, 1)))

def welch_anova(groups_data):
    """Welch ANOVA (Brown-Forsythe / Welch F-test for unequal variances).
    groups_data: list of arrays, one per group.
    Returns: F, p, df1, df2, eta2
    """
    k = len(groups_data)
    ns   = np.array([len(g) for g in groups_data])
    ms   = np.array([np.mean(g) for g in groups_data])
    vs   = np.array([np.var(g, ddof=1) for g in groups_data])
    ws   = ns / vs                          # weights
    W    = ws.sum()
    gm   = (ws * ms).sum() / W             # weighted grand mean
    # Welch F
    num  = np.sum(ws * (ms - gm)**2) / (k - 1)
    lam  = np.sum(((1 - ws / W)**2) / (ns - 1))
    den  = 1 + (2 * (k - 2) / (k**2 - 1)) * lam
    F    = num / den
    df1  = k - 1
    df2  = (k**2 - 1) / (3 * lam)
    p    = 1 - f_dist.cdf(F, df1, df2)
    # eta squared
    ss_b = np.sum(ws * (ms - gm)**2)
    ss_t = ss_b + df2
    eta2 = ss_b / ss_t if ss_t > 0 else np.nan
    return F, p, df1, df2, eta2

def games_howell(data_by_group, groups):
    """Games-Howell post-hoc test (no equal variance / sample size assumption).
    Returns:
        sig_pairs: set of (g1,g2) tuples where p<.05
        posthoc_str: compact string for the stat row
    """
    pairs = list(combinations(groups, 2))
    sig_pairs = set()
    pair_results = []
    has_nonsig = False
    for g1, g2 in pairs:
        d1, d2 = np.array(data_by_group[g1]), np.array(data_by_group[g2])
        n1, n2 = len(d1), len(d2)
        m1, m2 = np.mean(d1), np.mean(d2)
        v1, v2 = np.var(d1, ddof=1), np.var(d2, ddof=1)
        se = np.sqrt(v1/n1 + v2/n2)
        if se == 0:
            continue
        t_stat = abs(m1 - m2) / se
        df_num = (v1/n1 + v2/n2)**2
        df_den = (v1/n1)**2/(n1-1) + (v2/n2)**2/(n2-1)
        df_gh  = df_num / df_den if df_den > 0 else 1
        p = 2 * (1 - t_dist.cdf(t_stat, df_gh))
        sup1 = SUPERSCRIPTS.get(g1, g1)
        sup2 = SUPERSCRIPTS.get(g2, g2)
        if p < 0.05:
            sig_pairs.add((g1, g2))
            sig_pairs.add((g2, g1))
            pair_results.append((sup1 + sup2, p))
        else:
            has_nonsig = True
    # Group pairs by p-value bucket for compact display
    bucket_001 = [s for s, p in pair_results if p < 0.001]
    bucket_01  = [s for s, p in pair_results if 0.001 <= p < 0.01]
    bucket_05  = [(s, p) for s, p in pair_results if 0.01 <= p < 0.05]
    parts = []
    if bucket_001:
        parts.append(' '.join(bucket_001) + ' p<.001')
    if bucket_01:
        parts.append(' '.join(bucket_01) + ' p<.01')
    for s, p in bucket_05:
        parts.append(f"{s} p={p:.3f}")
    if has_nonsig:
        parts.append('rest p>.05')
    posthoc_str = 'Post-hoc: ' + '; '.join(parts) if parts else 'Post-hoc: all p>.05'
    return sig_pairs, posthoc_str

def get_superscripts(group, sig_pairs, groups):
    """Return superscript letters for groups significantly different from this one."""
    sups = ''
    for other in groups:
        if other != group and (group, other) in sig_pairs:
            sups += SUPERSCRIPTS[other]
    return sups

def posthoc_chi2_fdr(df_in, group_col, var, groups):
    pairs = list(combinations(groups, 2))
    p_values, results = [], []
    for g1, g2 in pairs:
        dp = df_in[df_in[group_col].isin([g1, g2])]
        try:
            ct, _, _ = safe_crosstab(dp[group_col].tolist(), dp[var].tolist())
            _, p, _, _ = chi2_contingency(ct)
            p_values.append(p)
            results.append({'g1': g1, 'g2': g2, 'p_raw': p})
        except:
            p_values.append(1.0)
            results.append({'g1': g1, 'g2': g2, 'p_raw': 1.0})
    reject, p_adj, _, _ = multipletests(p_values, alpha=0.05, method='fdr_bh')
    sig_pairs = set()
    for i, r in enumerate(results):
        if reject[i]:
            sig_pairs.add((r['g1'], r['g2']))
            sig_pairs.add((r['g2'], r['g1']))
    return sig_pairs

