    cell.font      = f_family
    cell.fill      = no_fill
    cell.alignment = Alignment(horizontal='left', vertical='center', indent=1)
    cell.border    = make_border(top='medium', bottom='thin', left='thin', right='thin')
    ws3.row_dimensions[current_row3].height = 18
    current_row3 += 1

    for fv in vif_list:
        row_vals = [f"  {fv['label']}"]
        for pname in all_pred_names:
            vif_val = fv['vif'].get(pname, np.nan)
            # Flag VIF > 5 with asterisk
            if not np.isnan(vif_val):
                flag = ' †' if vif_val > 5 else ''
                row_vals.append(f"{vif_val:.2f}{flag}")
            else:
                row_vals.append("—")

        for col_i, val in enumerate(row_vals, 1):
            cell = ws3.cell(row=current_row3, column=col_i, value=val)
            cell.font      = f_normal
            cell.fill      = no_fill
            cell.alignment = Alignment(
                horizontal='left' if col_i == 1 else 'center',
                vertical='center'
            )
            cell.border = make_border(
                left='medium' if col_i == 1 else 'thin',
                right='medium' if col_i == N_VIF_COLS else 'thin'
            )
        ws3.row_dimensions[current_row3].height = 18
        current_row3 += 1

    for col_i in range(1, N_VIF_COLS + 1):
        cell = ws3.cell(row=current_row3 - 1, column=col_i)
        cell.border = Border(
            top=cell.border.top, bottom=Side(style='medium'),
            left=cell.border.left, right=cell.border.right
        )

