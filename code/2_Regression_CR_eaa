# SHEET 3 — VIF
# Rows = clocks (grouped by family), columns = predictors
# ══════════════════════════════════════════════════════════════════
ws3 = wb.create_sheet(title="VIF")

# Collect all predictor std names (CR_binary + covariates)
# Map std names to readable labels
vif_label_map = {
    'CR_binary':    'Cardiometabolic risk',
    'demo_age_z':   'Age',
    'demo_sex':     'Sex',
    'cog_ed_z':     'Years of education',
    'dementia':     'Diagnosis (dementia)',
    'meds_rc':      'Cardiometabolic medication',
    'demo_age':     'Age',
    'cog_ed':       'Years of education',
}

# Determine columns from first available VIF dict
all_pred_names = []
for family, vif_list in all_vif.items():
    for fv in vif_list:
        if fv.get('predictors_std'):
            all_pred_names = fv['predictors_std']
            break
    if all_pred_names:
        break

N_VIF_COLS = 1 + len(all_pred_names)   # Clock label + one per predictor

ws3.column_dimensions['A'].width = 28
for i in range(2, N_VIF_COLS + 1):
    ws3.column_dimensions[get_column_letter(i)].width = 22

# Title
ws3.merge_cells(f'A1:{get_column_letter(N_VIF_COLS)}1')
cell = ws3['A1']
cell.value = "Supplementary Table. Variance inflation factors (VIF) for each linear mixed model"
cell.font      = f_title
cell.alignment = Alignment(horizontal='left', vertical='center', wrap_text=True)
ws3.row_dimensions[1].height = 24

# Headers
vif_headers = ['Epigenetic Age Acceleration'] + [vif_label_map.get(p, p) for p in all_pred_names]
for col, hdr in enumerate(vif_headers, 1):
    cell = ws3.cell(row=2, column=col, value=hdr)
    cell.font      = f_header
    cell.fill      = no_fill
    cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
    cell.border    = make_border(
        top='medium', bottom='medium',
        left='medium' if col == 1 else 'thin',
        right='medium' if col == N_VIF_COLS else 'thin'
    )
ws3.row_dimensions[2].height = 24

current_row3 = 3

for family, vif_list in all_vif.items():
    ws3.merge_cells(f'A{current_row3}:{get_column_letter(N_VIF_COLS)}{current_row3}')
