def make_border(top='thin', bottom='thin', left='thin', right='thin'):
    return Border(
        top=Side(style=top), bottom=Side(style=bottom),
        left=Side(style=left), right=Side(style=right)
    )

def sig_stars(p):
    if np.isnan(p): return ''
    if p < 0.001:   return '***'
    if p < 0.01:    return '**'
    if p < 0.05:    return '*'
    return ''

def fmt(val, decimals=3):
    return f"{val:.{decimals}f}" if (val is not None and not np.isnan(val)) else "—"

