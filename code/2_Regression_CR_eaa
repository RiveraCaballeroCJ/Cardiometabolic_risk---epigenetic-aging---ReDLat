# ── LMM function — returns full model results ─────────────────────
def run_lmm(df_model, outcome, predictor, covariates, group_var):
    """
    Returns dict with:
      - predictor results: beta_std, ci_low, ci_hi, p, partial_eta2, n
      - covariate results: dict keyed by covariate name with same fields
      - marginal R2 of the full model
      - standardized predictor names (for VIF)
      - fitted dff (for VIF computation)
    """
    cols_needed = [outcome, predictor] + covariates + [group_var]
    dff = df_model[cols_needed].dropna().copy()

    if len(dff) < 20:
        return None

    y_mean, y_std = dff[outcome].mean(), dff[outcome].std()
    if y_std == 0:
        return None
    dff['y_std'] = (dff[outcome] - y_mean) / y_std

    std_name_map = {}   # original col -> name used in formula
    predictors_std = []
    for col in [predictor] + covariates:
        vals = dff[col]
        if vals.nunique() > 2:
            col_std = col + '_z'
            col_mean, col_s = vals.mean(), vals.std()
            dff[col_std] = (vals - col_mean) / col_s if col_s > 0 else 0.0
            predictors_std.append(col_std)
            std_name_map[col] = col_std
        else:
            predictors_std.append(col)
            std_name_map[col] = col

    formula_vars = ' + '.join(predictors_std)
    try:
        model  = MixedLM.from_formula(f'y_std ~ {formula_vars}', data=dff, groups=dff[group_var])
        result = model.fit(reml=True, method='lbfgs')
    except Exception as e:
        print(f"  Model failed for {outcome}: {e}")
        return None

    def extract_param(col_orig):
        name = std_name_map.get(col_orig, col_orig)
        if name not in result.params.index:
            matches = [k for k in result.params.index if col_orig in k]
            if not matches:
                return None
            name = matches[0]
        beta  = result.params[name]
        se    = result.bse[name]
        t_val = result.tvalues[name]
        df_r  = result.df_resid if hasattr(result, 'df_resid') else len(dff) - len(result.params)
        return {
            'beta_std':     beta,
            'ci_low':       beta - 1.96 * se,
            'ci_hi':        beta + 1.96 * se,
            'p':            result.pvalues[name],
            'partial_eta2': t_val**2 / (t_val**2 + df_r) if df_r > 0 else np.nan,
        }

    pred_res = extract_param(predictor)
    if pred_res is None:
        return None

    cov_res = {}
    for cov in covariates:
        cov_res[cov] = extract_param(cov)

    # Marginal R² (Nakagawa & Schielzeth approximation for LMM)
    # R²m = var(fixed) / (var(fixed) + var(random) + var(residual))
    # NOTE: result.fittedvalues includes random effects; we need fixed-effects only
    try:
        import patsy
        X_fixed    = patsy.dmatrix('~ ' + formula_vars, data=dff, return_type='dataframe')
        fe_params  = result.fe_params
        # Align columns in case patsy names differ slightly
        common     = [c for c in X_fixed.columns if c in fe_params.index]
        fixed_pred = X_fixed[common].values @ fe_params[common].values
        var_fixed  = np.var(fixed_pred)
        var_resid  = result.scale
        var_random = float(result.cov_re.values[0][0]) if hasattr(result, 'cov_re') else 0.0
        denom      = var_fixed + var_random + var_resid
        marginal_r2 = var_fixed / denom if denom > 0 else np.nan
    except Exception as e:
        print(f"  R² failed for {outcome}: {e}")
        marginal_r2 = np.nan

    return {
        'pred':         pred_res,
        'covariates':   cov_res,
        'marginal_r2':  marginal_r2,
        'n':            len(dff),
        'dff':          dff,
        'predictors_std': predictors_std,
    }

# ── Run all models ────────────────────────────────────────────────
all_results  = {}   # family -> list of result dicts (main predictor)
all_cov_res  = {}   # family -> list (covariate results per clock)
all_vif      = {}   # family -> list (VIF per clock)
all_r2       = {}   # clock label -> marginal R²

for family, clocks in clock_groups.items():
    family_results = []
    family_cov     = []
    family_vif     = []

    for col, label in clocks:
        empty = {
            'col': col, 'label': label,
            'beta_std': np.nan, 'ci_low': np.nan, 'ci_hi': np.nan,
            'p': np.nan, 'partial_eta2': np.nan, 'n': 0,
        }
        if col not in df.columns:
            print(f"  Warning: '{col}' not found — skipped.")
            family_results.append(empty)
            family_cov.append({'col': col, 'label': label, 'covariates': {c: None for c in COVARIATES}})
            family_vif.append({'col': col, 'label': label, 'vif': {}})
            continue

        res = run_lmm(df, col, 'CR_binary', COVARIATES, 'country')

        if res is None:
            family_results.append(empty)
            family_cov.append({'col': col, 'label': label, 'covariates': {c: None for c in COVARIATES}})
            family_vif.append({'col': col, 'label': label, 'vif': {}})
        else:
            family_results.append({'col': col, 'label': label, **res['pred'], 'n': res['n']})
            family_cov.append({'col': col, 'label': label,
                               'covariates': res['covariates'],
                               'marginal_r2': res['marginal_r2']})
            all_r2[label] = res['marginal_r2']

            # VIF on standardized design matrix (predictors only, no intercept)
            dff_vif = res['dff'][res['predictors_std']].dropna()
            vif_dict = {}
            try:
                X_vif = dff_vif.values
                for i, pname in enumerate(res['predictors_std']):
                    vif_dict[pname] = variance_inflation_factor(X_vif, i)
            except Exception:
                for pname in res['predictors_std']:
                    vif_dict[pname] = np.nan
            family_vif.append({'col': col, 'label': label, 'vif': vif_dict,
                               'predictors_std': res['predictors_std']})

        print(f"  {label}: β={family_results[-1]['beta_std']:.3f}, p={family_results[-1]['p']:.4f}")

    # FDR for main predictor within family
    p_vals    = [r['p'] for r in family_results]
    valid_idx = [i for i, p in enumerate(p_vals) if not np.isnan(p)]
    p_fdr     = [np.nan] * len(family_results)
    if valid_idx:
        _, p_adj, _, _ = multipletests([p_vals[i] for i in valid_idx], alpha=0.05, method='fdr_bh')
        for i, idx in enumerate(valid_idx):
            p_fdr[idx] = p_adj[i]
    for i, r in enumerate(family_results):
        r['p_fdr'] = p_fdr[i]

    # FDR for each covariate within family
    for cov in COVARIATES:
        cov_ps    = [fc['covariates'].get(cov, {}) or {} for fc in family_cov]
        cov_pvals = [cp.get('p', np.nan) if cp else np.nan for cp in cov_ps]
        valid_idx_c = [i for i, p in enumerate(cov_pvals) if not np.isnan(p)]
        cov_pfdr = [np.nan] * len(family_cov)
        if valid_idx_c:
            _, p_adj_c, _, _ = multipletests([cov_pvals[i] for i in valid_idx_c], alpha=0.05, method='fdr_bh')
            for i, idx in enumerate(valid_idx_c):
                cov_pfdr[idx] = p_adj_c[i]
        for i, fc in enumerate(family_cov):
            if fc['covariates'].get(cov) is not None:
                fc['covariates'][cov]['p_fdr'] = cov_pfdr[i]
            elif fc['covariates'].get(cov) is None and cov in fc['covariates']:
                pass  # already None

    all_results[family] = family_results
    all_cov_res[family] = family_cov
    all_vif[family]     = family_vif
    print(f"  [{family}] done\n")

